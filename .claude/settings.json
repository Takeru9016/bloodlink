{
  "model": "claude-sonnet-5",
  "defaultMode": "acceptEdits",
  "effortLevel": "high",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter pub get)",
      "Bash(flutter pub run build_runner build*)",
      "Bash(dart format*)",
      "Bash(dart fix*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(flutter pub add*)",
      "Bash(flutter pub upgrade*)",
      "Bash(flutterfire configure*)",
      "Bash(firebase deploy*)",
      "Bash(firebase functions:secrets:set*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(curl*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/serviceAccountKey.json)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path'); case \"$file\" in *.dart) dart format \"$file\" ;; esac"
          }
        ]
      }
    ]
  }
}